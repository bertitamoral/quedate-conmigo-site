# Email delivery
RESEND_API_KEY=
RESEND_FROM="Berta Moral Martin <ventas@bertamoral.com>"
CONTACT_EMAIL_TO=contacto@bertamoral.com

# Purchase configuration
# BOOK_PRICE debe ser numerico (ej. 15.00). El envio es fijo: 0.75 EUR, sumado en codigo.
# EMAIL_CHECKOUT recibe el aviso de cada pedido (Bizum o Wallapop) con nombre y direccion.
EMAIL_CHECKOUT=bertag----@gmail.com
BIZUM_PHONE=+34 612 345678
BOOK_PRICE=15
WALLAPOP_CHECKOUT_URL=https://es.wallapop.com/item/libro-quedate-conmigo-1276333460

# Supabase (persistencia de pedidos y newsletter)
